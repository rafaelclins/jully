// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

model Restaurant {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  logo             String?
  primaryColor     String?
  secondaryColor   String?
  address          String?
  serviceFeePercent Decimal @default(0) @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tables     Table[]
  categories Category[]

  @@map("restaurants")
}

model Table {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  number       Int
  qrToken      String   @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  sessions   Session[]

  @@unique([restaurantId, number])
  @@unique([id, restaurantId])
  @@map("tables")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  name         String
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([restaurantId, name])
  @@unique([id, restaurantId])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @db.Uuid
  restaurantId String   @db.Uuid
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  image        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category    @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([id, restaurantId])
  @@index([categoryId])
  @@map("products")
}

model Session {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @db.Uuid
  tableId      String        @db.Uuid
  status       SessionStatus @default(OPEN)
  openedAt     DateTime      @default(now())
  closedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  table  Table   @relation(fields: [tableId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  orders Order[]

  @@unique([id, restaurantId])
  @@index([restaurantId])
  @@index([tableId])
  @@map("sessions")
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  sessionId          String      @db.Uuid
  restaurantId       String      @db.Uuid
  // Chave de idempotencia fornecida pelo cliente, unica por Session.
  // Escopo multi-tenant preservado: a Session ja e tenant-scoped pelas FKs
  // compostas (sessionId, restaurantId) -> sessions(id, restaurantId) e
  // (tableId, restaurantId) -> tables(id, restaurantId).
  idempotencyKey     String      @db.Uuid
  // SHA-256 hex do payload normalizado (productIds somados + ordenados).
  // Um pedido replaido deve ter exatamente o mesmo fingerprint.
  requestFingerprint String
  status             OrderStatus @default(PENDING)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  session Session     @relation(fields: [sessionId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  items   OrderItem[]

  @@unique([id, restaurantId])
  @@unique([sessionId, idempotencyKey])
  @@index([sessionId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @db.Uuid
  productId    String  @db.Uuid
  restaurantId String  @db.Uuid
  productName  String
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int     @default(1)
  subtotal     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  product Product @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}