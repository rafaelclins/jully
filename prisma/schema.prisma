// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

enum MembershipRole {
  OWNER
  OPERATOR
}

// Estado de uma tentativa/registro de pagamento (Etapa 15).
// O domínio do JULLY é menor que o domínio de qualquer gateway: sem REFUNDED
// enquanto refund não existir no core. Estados finais (PAID/FAILED/CANCELLED)
// não retornam para PENDING.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// Método de pagamento (separado do provedor — veja Payment.provider).
// Não é um enum rígido de providers; providers futuros ficam em TEXT.
enum PaymentMethod {
  PIX
  CARD
  CASH
  OTHER
}

model Restaurant {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  slug              String   @unique
  // Moeda operacional (ISO 4217 uppercase, ex.: "BRL", "USD", "EUR").
  // Validada no domínio (src/lib/money/currency.ts). One restaurant opera em
  // uma moeda por vez. Não há câmbio nem multi-currency dentro da conta.
  currency          String   @default("BRL")
  logo              String?
  primaryColor      String?
  secondaryColor    String?
  address           String?
  serviceFeePercent Decimal  @default(0) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tables       Table[]
  categories   Category[]
  memberships  RestaurantMembership[]

  @@map("restaurants")
}

model Table {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  number       Int
  qrToken      String   @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  sessions   TableSession[]

  @@unique([restaurantId, number])
  @@unique([id, restaurantId])
  @@map("tables")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  name         String
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([restaurantId, name])
  @@unique([id, restaurantId])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @db.Uuid
  restaurantId String   @db.Uuid
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  image        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category    @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([id, restaurantId])
  @@index([categoryId])
  @@map("products")
}

// Sessao do restaurante (mesa): fluxo do cliente na mesa (etapas 1-10).
// Renomeado de "Session" para "TableSession" para liberar o nome Session do
// Better Auth (modelo de sessao de autenticacao). A tabela fisica continua
// "sessions" — nenhum dado existente e alterado.
model TableSession {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @db.Uuid
  tableId      String        @db.Uuid
  status       SessionStatus @default(OPEN)
  openedAt     DateTime      @default(now())
  closedAt     DateTime?
  // ---------- Snapshots financeiros do fechamento (Etapa 14 + 15) ----------
  // NULL enquanto OPEN. Todos gravados atomicamente junto com status=CLOSED +
  // closedAt. Para CLOSED, o resumo financeiro é imutável: nunca mais depende
  // da configuração atual do Restaurant nem de Product.
  //
  // currencySnapshot (Etapa 15): congela a moeda operacional do Restaurant no
  // exato momento do fechamento. Se o Restaurant depois mudar BRL -> USD, as
  // Sessions CLOSED continuam BRL; a moeda histórica jamais é reinterpretada.
  // Validada no domínio (src/lib/money/currency.ts) no fechamento.
  closedSubtotal            Decimal? @db.Decimal(10, 2)
  serviceFeePercentSnapshot Decimal? @db.Decimal(5, 2)
  closedServiceFeeAmount    Decimal? @db.Decimal(10, 2)
  closedTotal               Decimal? @db.Decimal(10, 2)
  currencySnapshot          String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  table    Table     @relation(fields: [tableId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  orders   Order[]
  payments Payment[]

  @@unique([id, restaurantId])
  @@index([restaurantId])
  @@index([tableId])
  @@map("sessions")
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  sessionId          String      @db.Uuid
  restaurantId       String      @db.Uuid
  // Chave de idempotencia fornecida pelo cliente, unica por TableSession.
  // Escopo multi-tenant preservado: a TableSession ja e tenant-scoped pelas
  // FKs compostas (sessionId, restaurantId) -> sessions(id, restaurantId) e
  // (tableId, restaurantId) -> tables(id, restaurantId).
  idempotencyKey     String      @db.Uuid
  // SHA-256 hex do payload normalizado (productIds somados + ordenados).
  // Um pedido replaido deve ter exatamente o mesmo fingerprint.
  requestFingerprint String
  status             OrderStatus @default(PENDING)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  session TableSession @relation(fields: [sessionId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  items   OrderItem[]

  @@unique([id, restaurantId])
  @@unique([sessionId, idempotencyKey])
  @@index([sessionId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @db.Uuid
  productId    String  @db.Uuid
  restaurantId String  @db.Uuid
  productName  String
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int     @default(1)
  subtotal     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  product Product @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------- Pagamento (Etapa 15) ----------
// Tentativa/registro de pagamento relacionado a uma TableSession CLOSED.
// NÃO representa nenhum gateway específico: a fronteira com provedores
// (Stripe, Mercado Pago, maquininhas, PIX) é documentada/abstracta, e o campo
// `provider` (TEXT) recebe o identificador do provedor apenas na integração
// futura — nunca um enum rígido que gere migration por provedor.
// Nenhum dado sensível (número de cartão, CVV, senha, chave de gateway) é
// armazenado — apenas tokens/identificadores seguros do provider quando a
// integração existir.
//
// Semântica:
//   - amount/currency são DERIVADOS da Session fechada (closedTotal +
//     currencySnapshot) — o servidor/banco é a fonte da verdade, nunca o
//     browser;
//   - uma Session fechada possui no máximo UM pagamento efetivamente PAID
//     (índice parcial payments_one_paid_per_session — Prisma não expressa
//     partial unique). Tentativas PENDING/FAILED/CANCELLED podem coexistir;
//   - idempotência: unique(sessionId, idempotencyKey) — um retry da mesma
//     intenção nunca cria tentativas equivalentes;
//   - tenant: FK composta (sessionId, restaurantId) -> sessions(id, restaurantId);
//   - delete: Restrict — histórico financeiro nunca some em cascade.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  restaurantId      String        @db.Uuid
  sessionId         String        @db.Uuid
  // Total integral da Session fechada (closedTotal). Sem pagamento parcial em
  // nesta etapa. DECIMAL(10,2) exato, compativel com as moedas iniciais.
  amount            Decimal       @db.Decimal(10, 2)
  // Moeda congelada no fechamento: deve ser igual a sessions.currencySnapshot.
  currency          String
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod?
  provider          String?
  // Identificador seguro junto ao provedor (Etapa 16). Unico em conjunto com
  // (provider, providerPaymentId): provedores diferentes podem gerar o mesmo
  // id textual, entao a unicidade global nao vale; apenas dentro do mesmo
  // provider. NULL e tolerado multiplas vezes pelo Postgres (linhas ainda nao
  // integradas/ambíguas nao colidem).
  providerPaymentId String?
  // Chave de idempotência UUID fornecida pelo cliente/fluxo de integração.
  idempotencyKey    String        @db.Uuid
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  session TableSession @relation(fields: [sessionId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@unique([id, restaurantId])
  // Idempotência tenant-safe: a Session já é tenant-scoped pela FK composta.
  @@unique([sessionId, idempotencyKey])
  // Etapa 16: provêders podem gerar o mesmo id textual -> unicidade por provider.
  @@unique([provider, providerPaymentId])
  @@index([sessionId])
  @@index([restaurantId])
  @@index([status])
  @@map("payments")
}

// ---------- Eventos de webhook de pagamento (Etapa 16) ----------
// Log de eventos recebidos de provedores. Alem de auditoria, e a base do
// replay protection: exclusive (provider, providerEventId) garante que um
// mesmo evento e processado no maximo uma vez (idempotencia do webhook).
//
// Nenhum payload bruto sensivel e armazenado: apenas referencias seguras
// (providerEventId, providerPaymentId, eventType) + carimbos. A aplicacao da
// transicao e separada (marcacao de Payment e atomica + validada pela state
// machine), portanto um evento tardio nunca regride um estado terminal.
//
// Cross-tenant: impossivel por construcao — o evento nao carrega tenant; o
// Payment e resolvido por (provider, providerPaymentId), ambos seguros do
// provedor, nunca por valores do browser.
model PaymentWebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String
  // Identificador deduplicavel do provedor (ex.: charge.updated event id).
  providerEventId   String
  // Referencia da cobrança no provedor, resolvida em payments(provider, id).
  providerPaymentId String
  // Tipo de evento bruto do provedor (traduzido pelo adapter do provider).
  eventType         String
  occurredAt        DateTime?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  // Resultado do processamento ("applied" | "ignored" | "no-regress" ...).
  outcome           String?

  @@unique([provider, providerEventId])
  @@index([provider, providerPaymentId])
  @@map("payment_webhook_events")
}

// ---------- Better Auth (Etapa 11) ----------
// Modelos exigidos pela versao atual do Better Auth (1.7.4) com o adapter
// Prisma. O CLI oficial (auth generate) gerou estes modelos; foram revisados.
// A tabela de sessao de autenticacao usa a tabela "session" (separada de
// "sessions", que e a sessao de mesa da aplicacao).

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   RestaurantMembership[]

  @@unique([email])
  @@map("user")
}

model Session {
  id         String   @id
  token      String   @unique
  userId     String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- Vinculo operador <-> restaurante (Etapa 11) ----------
// Um usuario pode participar de varios restaurantes; o vinculo e por entidade
// separada (nao um campo restaurantId no User).
model RestaurantMembership {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String
  restaurantId String         @db.Uuid
  role         MembershipRole @default(OPERATOR)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // onDelete: Cascade no usuario (remover usuario limpa seu vinculo);
  // onDelete: Restrict no restaurante (mesma politica de tenant das demais
  // FKs da aplicacao: nao destruir dados de operadores ao apagar tenant).
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("restaurant_memberships")
}