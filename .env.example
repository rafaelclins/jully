# Copie este arquivo para .env e preencha com valores reais.
# .env NÃO deve ser versionado no Git.

# Conexão com o banco PostgreSQL (usada pelo Prisma em prisma7.config.ts)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jully?schema=public"

# Better Auth (operadores do restaurante)
# Gere um valor forte com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=your-generated-secret
# URL base da aplicação (origem usada por cookies/CSRF do Better Auth)
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap de operadores (exclusivo para desenvolvimento)
# Gere o key com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_KEY=replace-with-a-long-random-hex-key

# Dev/testes locais: desliga o rate limit do Better Auth.
# NÃO defina em produção — o rate limit protege o login contra brute force.
# RATE_LIMIT_DISABLED=true