# Copie este arquivo para .env e preencha com valores reais.
# .env NÃO deve ser versionado no Git.

# Conexão com o banco PostgreSQL (usada pelo Prisma em prisma7.config.ts)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jully?schema=public"

# Better Auth (operadores do restaurante)
# Gere um valor forte com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=your-generated-secret
# URL base da aplicação (origem usada por cookies/CSRF do Better Auth)
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap de operadores (exclusivo para desenvolvimento)
# Gere o key com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_KEY=replace-with-a-long-random-hex-key

# Dev/testes locais: desliga o rate limit do Better Auth.
# NÃO defina em produção — o rate limit protege o login contra brute force.
# Em produção o servidor RECUSA processar /api/auth/* (HTTP 500 + log claro)
# se RATE_LIMIT_DISABLED=true estiver presente.
# RATE_LIMIT_DISABLED=true

# ---------------------------------------------------------------------------
# Política de IP para o rate limit (obrigatório ler antes de produzir)
# ---------------------------------------------------------------------------
# Regra (fail-closed): o JULLY NÃO confia em X-Forwarded-For enviado pelo
# cliente. Sem política declarada, nenhum header de IP é lido:
#   - dev/teste local  -> identidade 127.0.0.1 (predictable e testável);
#   - produção         -> bucket compartilhado por rota até declarar proxies.
#
# AUTH_IP_ADDRESS_HEADER
#   Nome do header de origem do IP que o SEU proxy de borda coloca.
#   Ex.: x-forwarded-for
#   Só é respeitado se AUTH_TRUSTED_PROXIES também estiver definido.
#   Definir um sem o outro em produção = configuração inválida (recusada).
# AUTH_IP_ADDRESS_HEADER=

# AUTH_TRUSTED_PROXIES
#   Lista separada por vírgula (sem espaços) dos IPs/CIDR dos SEUS proxies
#   reais (load balancer/nginx/cloud). NUNCA use 0.0.0.0/0 ou ::/0 (proxy
#   universal é recusado). Use os endereços da infraestrutura do deploy.
#   Ex.: AUTH_TRUSTED_PROXIES=203.0.113.10,10.0.0.0/24
#   Obs.: só é seguro confiar no header quando a origem não é acessível
#   diretamente por clientes (acesso somente via os proxies declarados).
# AUTH_TRUSTED_PROXIES=

# Security headers / HSTS (JUL-02)
# SECURITY_HSTS_ENABLED liga Strict-Transport-Security + upgrade-insecure-
# requests NA RESPOSTA. Só ative quando a terminação HTTPS da infraestrutura
# estiver garantida (NÃO em HTTP localhost). includeSubDomains/preload exigem
# justificativa explícita de que são seguros para a infra futura.
# SECURITY_HSTS_ENABLED=false
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
# SECURITY_HSTS_PRELOAD=false
# SECURITY_HSTS_MAX_AGE=31536000